#!/usr/bin/env zsh

set -e

setopt RE_MATCH_PCRE

git_remote=$(git config --get remote.origin.url)

default_branch=$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')

if [[ $git_remote =~ '(?:(?:ssh://)?git@github.com|https://github.com)/([A-Za-z0-9](?:(?:[A-Za-z0-9]|\-(?!\-))+[A-Za-z0-9])?)/([A-Za-z0-9_\-\.]+(?<!\.git))(?:\.git)?$' ]]; then
  owner=$match[1]
  name=$match[2]
else 
  echo "Could not parse a GitHub project from ${git_remote}"
  exit 1
fi

current_branch=$(git rev-parse --abbrev-ref HEAD)

open "https://github.com/$(url-encode $owner)/$(url-encode $name)/compare/$(url-encode $default_branch)...$(url-encode $current_branch)"
